{
  "name": "imbir-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "build:pages": "tsc -p . && vite build --base=/imbir-crm-demo/",
    "deploy": "npm run build:pages && gh-pages -d dist -b gh-pages --nojekyll -r https://github.com/Seitek2002/imbir-crm-demo.git -u \"Seitek2002 <71016647+Seitek2002@users.noreply.github.com>\" -m \"Deploy demo\"",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "lint": "eslint",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "steiger": "^0.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
